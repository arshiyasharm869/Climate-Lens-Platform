# Gemini API Key (optional). Without it, Climate AI still shows live weather with an auto-generated summary.
GEMINI_API_KEY=

# Optional: override the Gemini model used by the server
# GEMINI_MODEL=

# Server Port (default 3000)
PORT=3000

# Optional: free NASA FIRMS key to show wildfire hotspots on the Live Climate Map
# Get one at https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=
